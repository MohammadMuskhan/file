import sqlite3
from pathlib import Path
from datetime import datetime

# Database file path
DB_FILE = Path("attendance.db")


# Create database and attendance table
def initialize_database():
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS attendance (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            student_name TEXT NOT NULL,
            date TEXT NOT NULL,
            status TEXT NOT NULL
        )
    """)

    conn.commit()
    conn.close()


# Mark student attendance
def mark_attendance():
    student_name = input("Enter student name: ").strip()

    if not student_name:
        print("Student name cannot be empty.")
        return

    attendance_date = input(
        "Enter date (YYYY-MM-DD), or press Enter for today: "
    ).strip()

    if not attendance_date:
        attendance_date = datetime.now().strftime("%Y-%m-%d")
    else:
        try:
            datetime.strptime(attendance_date, "%Y-%m-%d")
        except ValueError:
            print("Invalid date format. Please use YYYY-MM-DD.")
            return

    status = input("Enter attendance status (Present/Absent): ").strip().title()

    if status not in ("Present", "Absent"):
        print("Invalid status. Please enter Present or Absent.")
        return

    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()

    cursor.execute("""
        INSERT INTO attendance (student_name, date, status)
        VALUES (?, ?, ?)
    """, (student_name, attendance_date, status))

    conn.commit()
    conn.close()

    print("Attendance marked successfully!")


# View all attendance records
def view_attendance():
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()

    cursor.execute("""
        SELECT id, student_name, date, status
        FROM attendance
        ORDER BY date DESC, student_name ASC
    """)

    records = cursor.fetchall()
    conn.close()

    if not records:
        print("\nNo attendance records found.")
        return

    print("\n" + "=" * 65)
    print(f"{'ID':<5}{'Student Name':<25}{'Date':<15}{'Status':<12}")
    print("=" * 65)

    for record in records:
        print(
            f"{record[0]:<5}"
            f"{record[1]:<25}"
            f"{record[2]:<15}"
            f"{record[3]:<12}"
        )

    print("=" * 65)


# Search attendance by student name
def search_attendance():
    student_name = input("Enter student name to search: ").strip()

    if not student_name:
        print("Please enter a student name.")
        return

    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()

    cursor.execute("""
        SELECT id, student_name, date, status
        FROM attendance
        WHERE student_name LIKE ?
        ORDER BY date DESC
    """, (f"%{student_name}%",))

    records = cursor.fetchall()
    conn.close()

    if not records:
        print("No matching attendance records found.")
        return

    print("\nSearch Results")
    print("-" * 60)

    for record in records:
        print(
            f"ID: {record[0]} | "
            f"Name: {record[1]} | "
            f"Date: {record[2]} | "
            f"Status: {record[3]}"
        )


# Display attendance summary
def attendance_summary():
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()

    cursor.execute("""
        SELECT student_name,
               COUNT(*) AS total_days,
               SUM(CASE WHEN status = 'Present' THEN 1 ELSE 0 END)
                   AS present_days,
               SUM(CASE WHEN status = 'Absent' THEN 1 ELSE 0 END)
                   AS absent_days
        FROM attendance
        GROUP BY student_name
        ORDER BY student_name
    """)

    records = cursor.fetchall()
    conn.close()

    if not records:
        print("No attendance records available.")
        return

    print("\nAttendance Summary")
    print("-" * 75)
    print(
        f"{'Student Name':<25}"
        f"{'Total':<10}"
        f"{'Present':<10}"
        f"{'Absent':<10}"
        f"{'Percentage':<15}"
    )
    print("-" * 75)

    for name, total, present, absent in records:
        percentage = (present / total * 100) if total else 0

        print(
            f"{name:<25}"
            f"{total:<10}"
            f"{present:<10}"
            f"{absent:<10}"
            f"{percentage:.2f}%"
        )


# Main menu
def main():
    initialize_database()

    while True:
        print("\n===== ATTENDANCE MANAGEMENT SYSTEM =====")
        print("1. Mark Attendance")
        print("2. View All Attendance")
        print("3. Search Student Attendance")
        print("4. Attendance Summary")
        print("5. Exit")

        choice = input("Enter your choice (1-5): ").strip()

        if choice == "1":
            mark_attendance()
        elif choice == "2":
            view_attendance()
        elif choice == "3":
            search_attendance()
        elif choice == "4":
            attendance_summary()
        elif choice == "5":
            print("Thank you for using the Attendance Management System!")
            break
        else:
            print("Invalid choice. Please enter a number from 1 to 5.")


if _name_ == "_main_":
    main()
